# Cloudflare Pages Redirects
# Static site migration from sedentist.com
#
# NOTE: do NOT redirect trailing-slash URLs to non-trailing-slash. Every route
# is a directory with an index.html, so Cloudflare Pages auto-adds the slash
# back, creating an infinite 302<->308 loop. Trailing-slash URLs serve directly.

# Pagination (no real pages for these)
/blog/page/*/                     /blog
/category/*/page/*/               /blog
/author/*/page/*/                 /about

# Pagination
/blog/page/*/                     /blog
/category/*/page/*/               /blog
/author/*/page/*/                 /about

# Feed URLs - block these
/feed/                            /404
/comments/feed/                   /404
/wp-json/                         /404

# WordPress specific - block access
/wp-admin/                        /404
/wp-login.php                     /404
/wp-content/                      /404
/wp-includes/                     /404
/xmlrpc.php                       /404
